# Envio HyperSync token (free at https://envio.dev/app/api-tokens). Required for `envio dev`.
ENVIO_API_TOKEN=
# Platform ingest (API FR-API-070). The indexer's only secret is ENVIO_INGEST_TOKEN.
# Envio Cloud only injects variables prefixed ENVIO_, hence the prefix.
ENVIO_INGEST_URL=http://localhost:4000/internal/ingest
ENVIO_INGEST_TOKEN=

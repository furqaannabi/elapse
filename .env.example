# Platform
ELAPSE_SECRET_KEY=sk_test_
ELAPSE_WEBHOOK_SECRET=whsec_
DATABASE_URL=postgres://elapse:elapse@localhost:55434/elapse
# TEST_DATABASE_URL=postgres://elapse:elapse@localhost:55434/elapse_test
PORT=4000
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts webhook signing secrets at rest.
WEBHOOK_SECRET_KEK=
# Dashboard origin: magic links point here and only this Origin may mutate with a session cookie.
DASHBOARD_ORIGIN=http://localhost:3000
# The docs site, whose API reference calls the API from the browser with a test key (FR-API-086). Leave unset to disable.
DOCS_ORIGIN=
# Public base URL written into api/openapi.json by `bun run openapi` (FR-API-085).
PUBLIC_API_URL=http://localhost:4000
# Email (Resend). Unset outside production = magic links are printed to the API's stdout.
RESEND_API_KEY=
EMAIL_FROM=Elapse <no-reply@elapse.finance>

# Shared secret for the indexer → POST /internal/ingest. `openssl rand -hex 32`; same value as ENVIO_INGEST_TOKEN in indexer/.env.
INGEST_TOKEN=

# Chain
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Checkout (web/.env.local)
NEXT_PUBLIC_PRIVY_APP_ID=
# Platform API the hosted page calls; unset = every session uses the in-memory mock (seeded demo ids always do)
NEXT_PUBLIC_ELAPSE_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=10143
RELAYER_PRIVATE_KEY=

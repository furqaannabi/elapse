# Copy to api/.env (gitignored). Bun loads it automatically for `bun run dev`, `worker`, `migrate`.
# Tests ignore this file: test/setup.ts forces the test database and test tokens.

# Postgres (docker compose up -d in api/ gives you this one)
DATABASE_URL=postgres://elapse:elapse@localhost:55434/elapse
PORT=4000

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts webhook signing secrets at rest.
WEBHOOK_SECRET_KEK=

# Dashboard origin: magic links point here and only this Origin may mutate with a session cookie.
DASHBOARD_ORIGIN=http://localhost:3000
# The docs site, whose API reference calls the API from the browser with a test key (FR-API-086). Leave unset to disable.
DOCS_ORIGIN=
# Public base URL written into api/openapi.json by `bun run openapi` (FR-API-085).
PUBLIC_API_URL=http://localhost:4000
# Hosted checkout base; session URLs are <this>/c/cs_…
NEXT_PUBLIC_CHECKOUT_URL=http://localhost:3000

# Email (Resend). Unset outside production = magic links are printed to stdout.
RESEND_API_KEY=
EMAIL_FROM=Elapse <no-reply@elapse.finance>

# Indexer → POST /internal/ingest. `openssl rand -hex 32`; same value as ENVIO_INGEST_TOKEN in indexer/.env.
INGEST_TOKEN=

# Chain. Test mode = 10143 with MockUSD; live = 143 with AUSD.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# The relayer: holds MON for gas only, never AUSD; the only key that can open a stream.
# Never commit, never paste in chat. On testnet: `~/.foundry/bin/cast wallet decrypt-keystore <name> | awk '{print "RELAYER_PRIVATE_KEY=" $NF}' >> api/.env`
RELAYER_PRIVATE_KEY=

# Indexer GraphQL for GET /v1/status (server-side only). Local `envio dev` default; hosted URL in production.
INDEXER_GRAPHQL_URL=http://localhost:8080/v1/graphql

# Worker tuning (optional)
# WORKER_CONCURRENCY=16
# WORKER_BATCH=50
# Keeper (runs inside the worker; needs the relayer vars above). KEEPER=0 disables.
# KEEPER_CADENCE_S=300
# KEEPER_TICK_MS=30000

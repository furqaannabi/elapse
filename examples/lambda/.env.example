# Elapse merchant secret key: Dashboard → Developers → API keys → Create. Server only.
ELAPSE_SECRET_KEY=sk_test_…
# Publishable key for the same mode. The console page carries this one, on purpose.
ELAPSE_PUBLISHABLE_KEY=pk_test_…
# Webhook signing secret: printed by `npx @elapse/cli listen --forward localhost:3000/webhooks`.
ELAPSE_WEBHOOK_SECRET=whsec_…
# The hosted Elapse API.
ELAPSE_API_URL=https://api.elapse.finance
# Where the Elapse window that asks for Face ID lives. Only change this against a local Elapse.
ELAPSE_APP_URL=https://elapse.finance
# This server.
PORT=3000
BASE_URL=http://localhost:3000
# AWS: the region the runner was deployed to. Credentials come from the standard AWS chain
# (aws configure / AWS_PROFILE / env), never from this file.
AWS_REGION=us-east-1
# The runner function created in "Provision the runner".
LAMBDA_FN=elapse-lambda-runner
# Hard cap on executions per UTC day across all sessions — the AWS cost guard.
DAILY_RUN_LIMIT=20
# Session cap: rate × this is the most a session can ever cost (on-chain backstop). 3600 = 1 hour.
MAX_DURATION_SECONDS=3600
# Auto-end: cancel a session after this many seconds with no Run.
IDLE_TIMEOUT_SECONDS=60
# Auto-end: cancel a session whose console heartbeat has been silent this long (tab closed / left).
HEARTBEAT_STALE_SECONDS=15

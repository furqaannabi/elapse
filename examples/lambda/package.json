{
  "name": "elapse-example-lambda",
  "version": "0.1.0",
  "private": true,
  "description": "Per-second serverless compute: a live code session on real AWS Lambda, billed by the second through Elapse, authorised and metered in the console with @elapse/react.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build:web && tsx src/index.ts",
    "demo:check": "tsx src/demo-check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.658.0",
    "@elapse/react": "^0.3.0",
    "@elapse/sdk": "^0.3.0",
    "dotenv": "^17.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

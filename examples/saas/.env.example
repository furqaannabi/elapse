# Secret key for test mode. Dashboard → Developers → API keys → Create. Server only.
ELAPSE_SECRET_KEY=sk_test_…
# Publishable key for the same mode. This one is in the page's HTML on purpose.
ELAPSE_PUBLISHABLE_KEY=pk_test_…
# Printed on the first line when you run: npx @elapse/cli listen --forward localhost:3000/webhooks
ELAPSE_WEBHOOK_SECRET=whsec_…
# The hosted Elapse API.
ELAPSE_API_URL=https://api.elapse.finance
# Where the Elapse window that asks for Face ID lives. Only change this against a local Elapse.
ELAPSE_APP_URL=https://elapse.finance
# Where this server listens and its public URL.
PORT=3000
BASE_URL=http://localhost:3000

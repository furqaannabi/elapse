{
  "name": "@elapse/react",
  "version": "0.4.1",
  "description": "Authorise, meter and receipt components for Elapse per-second billing.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/elapse.browser.js",
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js",
      "require": "./dist/math.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "README.md",
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "motion": "^13",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "motion": "^13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "jsdelivr": "./dist/elapse.browser.js",
  "unpkg": "./dist/elapse.browser.js"
}

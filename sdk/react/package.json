{
  "name": "@elapse/react",
  "version": "0.1.0",
  "description": "Authorise, meter and receipt components for Elapse per-second billing.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css",
    "./math": "./src/math.ts"
  },
  "files": [
    "README.md",
    "dist",
    "src/math.ts",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "motion": "^13",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "motion": "^13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
